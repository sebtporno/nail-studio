# ==== Скопируйте этот файл в .env и заполните ====

# Порт сайта
PORT=3000

# Секрет для токенов входа — ОБЯЗАТЕЛЬНО поменяйте на длинную случайную строку
JWT_SECRET=change-me-to-a-long-random-string

# Логин и пароль для входа в панель мастера (создаётся автоматически при первом запуске)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Подключение к PostgreSQL (в продакшене / на хостинге)
# Локально можно не указывать — тогда поднимется встроенная база (быстрый старт)
# DATABASE_URL=postgres://user:password@localhost:5432/nail_atelier

# Для облачного Postgres, если TLS обязателен
# PGSSL=true

# Домен админки, если она на другом сайте (необязательно)
# ALLOW_ORIGIN=https://example.com

# ==== Уведомления о новых заявках в Telegram ====
# Токен бота от @BotFather и id чата мастера.
# Их можно не задавать здесь, а подключить бота прямо в панели мастера (вкладка «Уведомления»).
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=123456789
